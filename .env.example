# Copy to .env and fill in. Never commit .env.

# LLM provider: "openai_compatible" for a real endpoint, "stub" for recorded responses.
LLM_PROVIDER=stub
# OpenAI-compatible endpoint (Groq in the POC).
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model name sent to the endpoint.
LLM_MODEL=openai/gpt-oss-120b
# API key for the endpoint. Required when LLM_PROVIDER=openai_compatible.
LLM_API_KEY=
# Directory of recorded responses used when LLM_PROVIDER=stub.
LLM_STUB_FIXTURES=tests/fixtures/llm/skeleton

# Any value in config/settings.yaml can be overridden with
# SYNTHGEN_<GROUP>__<KEY> (nested groups joined with "__"), for example:
# SYNTHGEN_PATHS__DATA_DIR=/home/me/synthgen/data
# SYNTHGEN_PATHS__OUTPUT_DIR=/home/me/synthgen/output
# SYNTHGEN_AGENT__CAPS__SPEC_REPAIR=3
